# Copy this file to .env.local and fill in the values from
# scripts/apps-script/README.md

GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Set this once the production domain is decided, so shared links resolve
# OG/Twitter card images correctly. Falls back to the Vercel preview URL,
# then localhost, if unset.
NEXT_PUBLIC_SITE_URL=
